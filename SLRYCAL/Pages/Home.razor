@page "/"

<MudAppBar Elevation="0" Color="Color.Primary" Dense="true">
    <MudText Typo="Typo.h6" Class="ml-2">Salary Calculator</MudText>
</MudAppBar>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    <MudGrid Justify="Justify.Center" Class="mt-4">
        <MudItem xs="12" sm="10" md="6">
            <MudCard Class="pa-4 mud-card-rounded" Elevation="6" Style="background: linear-gradient(135deg, #e3f2fd 0%, #fce4ec 100%);">
                <MudCardContent>
                    <MudForm>
                        <MudText Typo="Typo.h6" Class="mb-2">Select Month</MudText>
                        <MudSelect T="int" Label="Month" @bind-Value="month" Variant="Variant.Filled" Dense="true" Class="mb-3">
                            <MudSelectItem Value="1">January</MudSelectItem>
                            <MudSelectItem Value="2">February</MudSelectItem>
                            <MudSelectItem Value="3">March</MudSelectItem>
                            <MudSelectItem Value="4">April</MudSelectItem>
                            <MudSelectItem Value="5">May</MudSelectItem>
                            <MudSelectItem Value="6">June</MudSelectItem>
                            <MudSelectItem Value="7">July</MudSelectItem>
                            <MudSelectItem Value="8">August</MudSelectItem>
                            <MudSelectItem Value="9">September</MudSelectItem>
                            <MudSelectItem Value="10">October</MudSelectItem>
                            <MudSelectItem Value="11">November</MudSelectItem>
                            <MudSelectItem Value="12">December</MudSelectItem>
                        </MudSelect>
                        <MudTextField T="double" Label="Base Salary (THB)" @bind-Value="BaseSalary" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Required="true" RequiredError="Base Salary is required!" Variant="Variant.Filled" Class="mb-3" />
                        <MudTextField T="double" Label="Other Allowance (THB)" @bind-Value="OtherAllowance" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Variant="Variant.Filled" Class="mb-3" />
                        <MudTextField T="double" Label="Performance Bonus (THB)" @bind-Value="PerformanceBonus" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.EmojiEvents" Variant="Variant.Filled" Class="mb-3" />
                        <MudTextField T="int" Label="OT Normal Days" @bind-Value="OtNormalDays" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Event" Variant="Variant.Filled" Class="mb-3" />
                        <MudTextField T="int" Label="OT Holiday Days" @bind-Value="OtHolidayDays" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Event" Variant="Variant.Filled" Class="mb-3" />
                        <MudTextField T="int" Label="Leave Days" @bind-Value="LeaveDays" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.EventBusy" Variant="Variant.Filled" Class="mb-3" />
                        <MudTextField T="double" Label="Social Security (THB)" @bind-Value="SocialSecurity" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Security" Variant="Variant.Filled" Class="mb-3" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CalculateSalary" Class="mt-4 mud-width-full" Style="border-radius: 24px;">Calculate Salary</MudButton>
                    </MudForm>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="10" md="6" Class="mt-4">
            @if (HasCalculated)
            {
                <MudCard Class="pa-4 mud-card-rounded" Elevation="6" Style="background: linear-gradient(135deg, #fce4ec 0%, #e3f2fd 100%);">
                    <MudCardContent>
                        <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-2">
                            <MudAvatar Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Primary" Size="Size.Large" Class="mr-2" />
                            Salary Breakdown
                        </MudText>
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.h6" Class="mud-text-primary mb-2">
                            Total Net Salary: <span style="font-weight:bold;">@Result.ToString("N2") THB</span>
                        </MudText>
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="Earnings" Icon="@Icons.Material.Filled.TrendingUp">
                                <MudList T="string" Dense="true">
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.AttachMoney" />
                                        <MudListItemText>Base Salary: @BaseSalary.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.AttachMoney" />
                                        <MudListItemText>Other Allowance: @OtherAllowance.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.EmojiEvents" />
                                        <MudListItemText>Performance Bonus: @PerformanceBonus.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.Event" />
                                        <MudListItemText>OT Pay (Normal): @OtNormalPay.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.Event" />
                                        <MudListItemText>OT Pay (Holiday): @OtHolidayPay.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.CalendarToday" />
                                        <MudListItemText>Holiday Pay: @HolidayPay.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.DirectionsBus" />
                                        <MudListItemText>Travel Allowance: @TravelAllowance.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.Hotel" />
                                        <MudListItemText>Accommodation Allowance: @AccommodationAllowance.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                </MudList>
                            </MudExpansionPanel>
                            <MudExpansionPanel Text="Deductions" Icon="@Icons.Material.Filled.TrendingDown">
                                <MudList T="string" Dense="true">
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.Fastfood" />
                                        <MudListItemText>Meal Deduction (@PublicHolidayDays days): @MealDeduction.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.EventBusy" />
                                        <MudListItemText>Total Leave Deduction: @TotalLeaveDeduction.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                    <MudListItem>
                                        <MudListItemIcon Icon="@Icons.Material.Filled.Security" />
                                        <MudListItemText>Social Security Deduction: @SocialSecurity.ToString("N2") THB</MudListItemText>
                                    </MudListItem>
                                </MudList>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudCardContent>
                </MudCard>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

<MudBottomNavigation Class="mud-width-full" Style="position:fixed;bottom:0;left:0;z-index:100;">
    <MudBottomNavigationItem Icon="@Icons.Material.Filled.Home" Label="Home" />
    <MudBottomNavigationItem Icon="@Icons.Material.Filled.Calculate" Label="Calculator" />
    <MudBottomNavigationItem Icon="@Icons.Material.Filled.Info" Label="Info" />
</MudBottomNavigation>

@code {
    // ... (your existing logic code remains unchanged)
    public double BaseSalary { get; set; }
    public double OtherAllowance { get; set; }
    public int OtNormalDays { get; set; }
    public int OtHolidayDays { get; set; }
    public double PerformanceBonus { get; set; } = 700;
    public int LeaveDays { get; set; }
    public double SocialSecurity { get; set; } = 750;
    public double Result { get; set; }
    public int year = 2025;
    public int month = 1;

    public double OtNormalPay { get; set; }
    public double OtHolidayPay { get; set; }
    public double HolidayPay { get; set; }
    public double TravelAllowance { get; set; }
    public double AccommodationAllowance { get; set; }
    public double TotalLeaveDeduction { get; set; }
    public int PublicHolidayDays { get; set; }
    public double MealDeduction { get; set; }

    public bool HasCalculated { get; set; } = false;

    public static class HolidayCalendar
    {
        private static readonly Dictionary<(int Year, int Month), int> Holidays = new()
        {
            { (2025, 1), 1 },
            { (2025, 2), 0 },
            { (2025, 3), 0 },
            { (2025, 4), 3 },
            { (2025, 5), 2 },
            { (2025, 6), 1 },
            { (2025, 7), 1 },
            { (2025, 8), 1 },
            { (2025, 9), 0 },
            { (2025, 10), 1 },
            { (2025, 11), 0 },
            { (2025, 12), 3 },
        };

        public static int GetHolidayDays(int year, int month)
        {
            return Holidays.TryGetValue((year, month), out int days) ? days : 0;
        }
    }

    private void CalculateSalary()
    {
        double hourlyRate = BaseSalary / 30 / 8.5;
        double dailyRate = BaseSalary / 30;

        OtNormalPay = hourlyRate * 1.5 * (OtNormalDays * 2);
        OtHolidayPay = hourlyRate * 3.0 * (OtHolidayDays * 2);

        HolidayPay = dailyRate * OtHolidayDays;

        TravelAllowance = Math.Max(0, (22 - LeaveDays) * 50);
        AccommodationAllowance = Math.Max(0, (30 - LeaveDays) * 40);

        double baseSalaryDeduction = (BaseSalary / 30) * LeaveDays;
        double otherAllowanceDeduction = (OtherAllowance / 30) * LeaveDays;
        TotalLeaveDeduction = baseSalaryDeduction + otherAllowanceDeduction;

        PublicHolidayDays = HolidayCalendar.GetHolidayDays(year, month);
        MealDeduction = PublicHolidayDays * 40;

        Result = (BaseSalary - baseSalaryDeduction)
                + (OtherAllowance - otherAllowanceDeduction)
                + OtNormalPay + OtHolidayPay + HolidayPay
                + TravelAllowance + AccommodationAllowance
                + PerformanceBonus
                - SocialSecurity
                - MealDeduction;

        HasCalculated = true;
    }
}